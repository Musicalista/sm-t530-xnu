From: Musicalista <musicalista@users.noreply.github.com>
Subject: [PATCH 0002/0006] soc/msm8226: add UARTDM serial console and ARM GIC-400 interrupt driver

Implement low-level Qualcomm UARTDM (Data Mover) serial driver mapped at
0xF991E000 with 115200 8N1 FIFO registers for PE_kprintf output.
Configure ARM Generic Interrupt Controller v2 (GIC-400) distributor at
0xF9000000 and CPU interface at 0xF9002000 for routing timer and peripheral
interrupts to the Mach core.
---
 include/msm8226_regs.h | 64 ++++++++++++++++++++++++++++++++++++++++++++++++++
 src/main.c             | 48 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 112 insertions(+)

diff --git a/include/msm8226_regs.h b/include/msm8226_regs.h
new file mode 100644
--- /dev/null
+++ b/include/msm8226_regs.h
@@ -0,0 +1,64 @@
+/*
+ * msm8226_regs.h - Qualcomm Snapdragon 400 (APQ8026 / MSM8226) MMIO & Registers
+ * Target: Samsung Galaxy Tab 4 10.1 (SM-T530 / matissewifi)
+ */
+
+#ifndef MSM8226_REGS_H
+#define MSM8226_REGS_H
+
+#define MSM8226_GIC_DIST_BASE       0xF9000000
+#define MSM8226_GIC_CPU_BASE        0xF9002000
+#define MSM8226_UARTDM_BASE         0xF991E000
+
+/* UARTDM Registers */
+#define UARTDM_MR1                  0x0000
+#define UARTDM_MR2                  0x0004
+#define UARTDM_SR                   0x0008
+#define UARTDM_CR                   0x0010
+#define UARTDM_MISR                 0x0010
+#define UARTDM_IMR                  0x0014
+#define UARTDM_IPR                  0x0018
+#define UARTDM_TFWR                 0x001C
+#define UARTDM_RFWR                 0x0020
+#define UARTDM_HCR                  0x0024
+#define UARTDM_DMRX                 0x0034
+#define UARTDM_NCF_TX               0x0040
+#define UARTDM_RF                   0x0070
+#define UARTDM_TF                   0x0070
+
+/* GIC-400 Registers */
+#define GICD_CTLR                   0x000
+#define GICD_TYPER                  0x004
+#define GICD_ISENABLER(n)           (0x100 + (n) * 4)
+#define GICD_ICENABLER(n)           (0x180 + (n) * 4)
+#define GICD_IPRIORITYR(n)          (0x400 + (n) * 4)
+#define GICD_ITARGETSR(n)           (0x800 + (n) * 4)
+#define GICD_ICFGR(n)               (0xC00 + (n) * 4)
+
+#define GICC_CTLR                   0x000
+#define GICC_PMR                    0x004
+#define GICC_IAR                    0x00C
+#define GICC_EOIR                   0x010
+
+#endif /* MSM8226_REGS_H */
diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -20,6 +20,48 @@ void uartdm_init(void) {
     mmio_write32(MSM8226_UARTDM_BASE + UARTDM_CR, 0x10);
 }

+void uartdm_putc(char c) {
+    while (!(mmio_read32(MSM8226_UARTDM_BASE + UARTDM_SR) & (1 << 3))) {}
+    mmio_write32(MSM8226_UARTDM_BASE + UARTDM_NCF_TX, 1);
+    mmio_write32(MSM8226_UARTDM_BASE + UARTDM_TF, (uint32_t)c);
+}
+
+void pe_kprintf(const char *fmt, ...) {
+    const char *p = fmt;
+    while (*p) {
+        if (*p == '\n') uartdm_putc('\r');
+        uartdm_putc(*p++);
+    }
+}
+
+void gic400_init(void) {
+    /* Disable Distributor */
+    mmio_write32(MSM8226_GIC_DIST_BASE + GICD_CTLR, 0);
+
+    /* Forward all interrupts to CPU 0 */
+    for (int i = 32; i < 160; i += 4) {
+        mmio_write32(MSM8226_GIC_DIST_BASE + GICD_ITARGETSR(i / 4), 0x01010101);
+    }
+
+    /* Enable Distributor */
+    mmio_write32(MSM8226_GIC_DIST_BASE + GICD_CTLR, 1);
+
+    /* Priority mask & enable CPU Interface */
+    mmio_write32(MSM8226_GIC_CPU_BASE + GICC_PMR, 0xF0);
+    mmio_write32(MSM8226_GIC_CPU_BASE + GICC_CTLR, 1);
+}
